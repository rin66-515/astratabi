# 本文件只用于本地 Docker。复制为 .env 后可覆盖 compose.yaml 中的开发默认值。
# 已有 PostgreSQL 卷中的管理员密码不会因修改此值而自动重置。
PORTAL_BOOTSTRAP_ADMIN_LOGIN_ID=admin-001
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=astratabi-local-admin
PORTAL_TOKEN_PEPPER=astratabi-local-only-token-pepper-change-before-production
PORTAL_ASRAY_CLIENT_ID=astratabi-local
PORTAL_ASRAY_HMAC_SECRET=replace-with-the-same-secret-configured-in-asray
PORTAL_ASRAY_ACTIVATION_URL_KEY=replace-with-base64-encoded-32-byte-key
